{
  "scripts": {
    "test": "node --test \"backend/test/**/*.test.js\"",
    "lint": "eslint backend --ext .js",
    "lint:fix": "eslint backend --ext .js --fix",
    "migrate:create": "node-pg-migrate create --migrations-dir backend/migrations_js",
    "migrate:up": "node-pg-migrate up --config backend/migrate.config.cjs --migrations-dir backend/migrations_js",
    "migrate:down": "node-pg-migrate down --config backend/migrate.config.cjs --migrations-dir backend/migrations_js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "node-pg-migrate": "^8.0.4",
    "supertest": "^7.2.2"
  }
}
