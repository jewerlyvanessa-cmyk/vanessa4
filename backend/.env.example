## Backend environment example (DO NOT put secrets in git)

# Server
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# CORS (comma-separated). Leave empty to allow all browser origins.
# Satu entri *.vanessa.id mengizinkan subdomain lain (app., mobile., http/https, www).
# UI production: https://app.vanessa.id — API: https://mobile.vanessa.id
# CORS_ORIGINS=https://mobile.vanessa.id,https://app.vanessa.id

# Database (PostgreSQL)
# Production: server terpisah dari API (bukan localhost).
# Hostname vanessa.id = alias ke 103.247.10.211 (sama server Postgres).
DB_USER=postgres
DB_HOST=vanessa.id
DB_NAME=vanessa_store
DB_PASSWORD=password
DB_PORT=5432

# SSL (recommended for production)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Zona waktu sesi PostgreSQL (TIMESTAMP tanpa zona = jam dinding toko)
# DB_TIMEZONE=Asia/Jakarta

# Google Drive backup (superadmin — menu Backup ke Google Drive)
# 1. Buat Service Account di Google Cloud, aktifkan Google Drive API
# 2. Unduh JSON key → simpan di server (jangan commit), set path di bawah
# 3. Buat folder Drive, share ke email service account (Editor)
# 4. Salin ID folder dari URL Drive ke GOOGLE_DRIVE_FOLDER_ID
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_PATH=/path/to/service-account.json
# Alternatif: satu baris JSON (escape) — GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Strict env checks (recommended for production)
STRICT_DB_ENV=false

# Log DB host/name on startup (helpful to confirm .env is loaded)
# LOG_DB_TARGET=true

PORT=3000
# Generate a new strong secret for each environment.
# Rotating this value will invalidate all existing JWTs immediately.
JWT_SECRET=vanessa_jwt_super_secret_2025 de3d07f5785680db64240e7ec2bc1a1f2b94d5efcf4f7013895e4a4fcb8b2dbc6175a077a6120759c03b5598eb83732a594edca4bd675b4d8cbdfabf596ddc88
# Optional: JWT expiration (e.g. 8h, 1d)
JWT_EXPIRES_IN=8h
# Comma-separated list of allowed web origins
CORS_ORIGINS=https://mobile.vanessa.id
