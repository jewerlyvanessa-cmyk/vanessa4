## Backend environment example (DO NOT put secrets in git)

# Server
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# CORS (comma-separated). Leave empty to allow all.
# CORS_ORIGINS=https://kumpulandoa.my.id,http://localhost:5173

# Database (PostgreSQL)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=vanessa3
DB_PASSWORD=password
DB_PORT=5432

# SSL (recommended for production)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Strict env checks (recommended for production)
STRICT_DB_ENV=false

PORT=3000
# Generate a new strong secret for each environment.
# Rotating this value will invalidate all existing JWTs immediately.
JWT_SECRET=vanessa_jwt_super_secret_2025 de3d07f5785680db64240e7ec2bc1a1f2b94d5efcf4f7013895e4a4fcb8b2dbc6175a077a6120759c03b5598eb83732a594edca4bd675b4d8cbdfabf596ddc88
# Optional: JWT expiration (e.g. 8h, 1d)
JWT_EXPIRES_IN=8h
# Comma-separated list of allowed web origins (e.g. https://app.example.com,https://admin.example.com)
CORS_ORIGINS=
