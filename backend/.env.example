## Backend environment example (DO NOT put secrets in git)

# Server
PORT=3000
NODE_ENV=development

# Auth — generate per environment: node backend/scripts/generate-jwt-secret.js
# Rotating JWT_SECRET invalidates all active sessions immediately.
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# Rate limit (opsional — default sudah aman untuk banyak user login bersamaan)
# LOGIN_RATE_LIMIT_MAX=60
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# WRITE_RATE_LIMIT_MAX=300
# WRITE_RATE_LIMIT_WINDOW_MS=60000

# Production behind nginx/reverse proxy (rate limit per IP benar)
# TRUST_PROXY=true

# CORS (comma-separated). Leave empty to allow all browser origins.
# Satu entri *.vanessa.id mengizinkan subdomain lain (app., mobile., http/https, www).
# UI production: https://app.vanessa.id — API: https://mobile.vanessa.id
# CORS_ORIGINS=https://mobile.vanessa.id,https://app.vanessa.id

# Database (PostgreSQL)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=vanessa_store
DB_PASSWORD=password
DB_PORT=5432

# SSL (wajib production — startup gagal jika NODE_ENV=production dan DB_SSL bukan true)
# Jika Postgres pakai sertifikat self-signed (error DEPTH_ZERO_SELF_SIGNED_CERT):
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Auth uploads: GET /uploads/* requires JWT (Authorization or ?access_token=)

# Legacy plaintext password in DB — NEVER enable in production
# ALLOW_LEGACY_PLAINTEXT_PASSWORD=false

# Zona waktu sesi PostgreSQL (TIMESTAMP tanpa zona = jam dinding toko)
# DB_TIMEZONE=Asia/Jakarta

# Google Drive backup (superadmin — menu Backup ke Google Drive)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_PATH=/path/to/service-account.json
# Alternatif: GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Strict env checks (recommended for production — also enforced when NODE_ENV=production)
STRICT_DB_ENV=false

# Log DB host/name on startup (helpful to confirm .env is loaded)
# LOG_DB_TARGET=true
