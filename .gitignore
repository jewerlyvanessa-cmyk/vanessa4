# Backend secrets (never commit)
/backend/.env
/backend/.env.*
!/backend/.env.example

# User uploads (runtime — keep directory only)
/backend/uploads/*
!/backend/uploads/.gitkeep

# Legacy mini upload server (removed from repo; ignore local leftovers)
/storage/express-backend/

# Ad-hoc screenshots at repo root
/flutter_*.png

# Common accidental pg_dump filename at repo root
/bcsql
